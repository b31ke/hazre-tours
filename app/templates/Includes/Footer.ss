        <nav class="foot-col" aria-label="Putovanja">
            <p class="foot-h">Putovanja</p>
            <a href="putovanja">Sva putovanja</a>
            <a href="kalendar">Kalendar polazaka</a>
            <% loop $MenuCategories.Limit(5) %><a href="$Link">$Title</a><% end_loop %>
        </nav>
        <nav class="foot-col" aria-label="Agencija">
            <p class="foot-h">Agencija</p>
            <% loop $Menu(1) %><% if $URLSegment != 'home' %><a href="$Link">$MenuTitle</a><% end_if %><% end_loop %>
            <a href="uslovi-putovanja">Uslovi putovanja</a>
            <a href="politika-privatnosti">Politika privatnosti</a>
            <a href="#" data-consent-open>Postavke kolačića</a>
        </nav>
        <div class="foot-col foot-contact">
            <p class="foot-h">Kontakt</p>
            <div class="fcard">
                <% with $SiteConfig.MainPhone %><a class="fcard-row is-phone" href="tel:$Tel"><span class="fcard-ico" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2"/></svg></span><span>$Number</span></a><% end_with %>
                <% if $SiteConfig.ContactEmail %><a class="fcard-row" href="mailto:$SiteConfig.ContactEmail"><span class="fcard-ico" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><span>$SiteConfig.ContactEmail</span></a><% end_if %>
                <% if $SiteConfig.Address %><a class="fcard-row" href="$SiteConfig.MapsLink" rel="noopener" target="_blank"><span class="fcard-ico" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg></span><span>$SiteConfig.Address</span></a><% end_if %>
            </div>
            <% if $SiteConfig.WorkingHours %><p class="foot-line muted">$SiteConfig.WorkingHours</p><% end_if %>
        </div>
    </div>

    <p class="foot-mark" aria-hidden="true"><span style="--i:0">H</span><span style="--i:1">A</span><span style="--i:2">Z</span><span style="--i:3">R</span><span style="--i:4">E</span><span class="fm-sp"> </span><span style="--i:6">T</span><span style="--i:7">O</span><span style="--i:8">U</span><span style="--i:9">R</span><span style="--i:10">S</span></p>

    <div class="wrap foot-bottom">
        <div class="foot-legal">
            <span>© $CurrentYear <% if $SiteConfig.CompanyName %>$SiteConfig.CompanyName<% else %>$SiteConfig.Title<% end_if %><% if $SiteConfig.LicenseNumber %> · Licenca $SiteConfig.LicenseNumber<% end_if %></span>
            <span class="foot-credit">Design by <a href="https://beshirt.ba/be-web/" rel="noopener" target="_blank" aria-label="BE SHIRT d.o.o."><img src="images/be-shirt-logo-white.png" alt="BE SHIRT d.o.o." width="66" height="18" loading="lazy"></a></span>
        </div>
        <a href="#top" class="to-top">Na vrh <span aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 19V5M6 11l6-6 6 6"/></svg></span></a>
    </div>
</footer>
