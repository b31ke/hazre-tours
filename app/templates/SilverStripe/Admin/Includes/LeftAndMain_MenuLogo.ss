<div class="cms-sitename hazre-sitename">
    <a class="cms-sitename__link hazre-sitename__logo" href="$BaseHref" target="_blank" aria-label="<% if $SiteConfig %>$SiteConfig.Title<% else %>$ApplicationName<% end_if %>, otvori sajt">
        <img class="hazre-logo-full" src="{$BaseURL}images/hazre-logo-light-sm.png" alt="" width="171" height="70">
        <img class="hazre-logo-mini" src="{$BaseURL}images/favicon-192.png" alt="" width="32" height="32">
    </a>
    <a class="cms-sitename__title hazre-sitename__site" href="$BaseHref" target="_blank">Otvori sajt ↗</a>
</div>
